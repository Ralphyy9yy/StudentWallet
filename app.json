{
  "expo": {
    "name": "StudentWallet",
    "slug": "StudentWallet",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/branding/icon.png",
    "scheme": "studentwallet",
    "userInterfaceStyle": "light",
    "platforms": ["android"],
    "android": {
      "icon": "./assets/branding/icon.png",
      "versionCode": 2,
      "package": "com.studentwallet.app",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#166534",
        "foregroundImage": "./assets/branding/adaptive-foreground.png",
        "monochromeImage": "./assets/branding/monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withLocalOnlyData.js",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAFAF7",
          "image": "./assets/branding/splash.png",
          "imageWidth": 112
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "fa5e4c21-fe2e-44e7-8bf9-31328937d262"
      }
    }
  }
}
